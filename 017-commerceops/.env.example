# ---- CommerceOps 環境変数の例（本番では秘密情報を必ず変更し、リポジトリにコミットしない） ----
NODE_ENV=production
PORT=3000
# アプリ用 DB ユーザーは SUPERUSER/BYPASSRLS を持たないこと（RLS が無効になるため）
DATABASE_URL=postgres://commerceops:CHANGE_ME@localhost:5432/commerceops
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# マイグレーションを別ユーザーで実行する場合のみ
# MIGRATION_DATABASE_URL=postgres://owner:CHANGE_ME@localhost:5432/commerceops
APP_BASE_URL=https://commerceops.example.com
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
# ロードバランサ/PaaS の背後で動かす場合 true（X-Forwarded-For を信頼）
TRUST_PROXY=true
# 添付ファイル（返品写真）とバックアップ一時ファイルの保存先（永続ディスク）
DATA_DIR=/data
# API と同一プロセスで Job worker を動かす（別プロセスにする場合 false にして `npm run worker -w server`）
RUN_WORKER=true
LOG_LEVEL=info
RATE_LIMIT_MAX=1200
LOGIN_RATE_LIMIT_MAX=20
MAX_UPLOAD_MB=20
# セルフサインアップ（SaaS として公開する場合のみ true）
ALLOW_SIGNUP=false
